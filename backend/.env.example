# Copy this file to ".env" and fill in your own values. Never commit ".env" to GitHub.

# Port the API server runs on
PORT=5000

# MongoDB connection string.
# Option A (recommended, zero install): MongoDB Atlas free cluster
#   MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/marketing_platform
# Option B: local MongoDB you installed yourself
#   MONGO_URI=mongodb://127.0.0.1:27017/marketing_platform
MONGO_URI=mongodb://127.0.0.1:27017/marketing_platform

# Secret used to sign login tokens (JWT). Use any long random string.
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Optional: only needed if you later wire up real generative ad-copy
# suggestions via Anthropic's API instead of the built-in template engine.
# ANTHROPIC_API_KEY=
